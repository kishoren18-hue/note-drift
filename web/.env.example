# Copy to .env.local for local development. All are optional: without them the
# checker still works; accounts and AI summaries show a "not configured" state.

# Supabase (browser + server). Safe to expose: access is enforced by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same values, read by the Python API for the per-user quota.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only secret. Never commit a real key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

NEXT_PUBLIC_SITE_URL=http://localhost:3000
