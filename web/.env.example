# Copy to .env.local for local development. All are optional: without them the
# checker still works; accounts and AI summaries show a "not configured" state.

# Supabase (browser + server). Safe to expose: access is enforced by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same values, read by the Python API for the per-user quota.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only secrets. Never commit a real key.
# Gemini is used when its key is set (free key: aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional alternative. Set AI_PROVIDER=anthropic to prefer it when both are set.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
AI_PROVIDER=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 after enabling the GitHub provider in Supabase to show "Continue with GitHub".
NEXT_PUBLIC_AUTH_GITHUB=
